# AG-UI 服务端地址（默认 http://localhost:8000/agent）
AG_UI_ENDPOINT=http://localhost:8000/agent

# 可选：活动 run 会话目录；留空时使用系统用户配置目录
# DEERFLOW_TUI_STATE_DIR=D:/path/to/deerflow-tui-state

# 可选：JSON 字符串格式的请求头，例如 Authorization
# AG_UI_HEADERS={"Authorization":"Bearer your-token"}

# 可选：JSON 对象字符串，作为初始 state 传给 Agent
# AG_UI_INITIAL_STATE={"user_id":"123"}
